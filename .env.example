# Comma-separated LLM API keys (minimum 2). Assigned key_1, key_2, ... in order.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# LiteLLM model identifier (e.g. gemini/gemini-2.0-flash, groq/llama-3.3-70b-versatile, openai/gpt-4o-mini)
LLM_MODEL=gemini/gemini-2.0-flash

# Optional: comma-separated models aligned 1:1 with LLM_API_KEYS if using keys across different models/providers
# LLM_MODELS=gemini/gemini-2.0-flash,groq/llama-3.3-70b-versatile

# Optional default system prompt when client does not send one
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# SQLite database path (Docker mounts a named volume at /data)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Enable X-Simulate-Failure test hook (must be true on deployed backend)
ENABLE_FAILURE_SIMULATION=true

# Frontend build-time API URL
VITE_API_BASE_URL=http://localhost:8000
